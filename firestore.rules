rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminWrite() {
      return request.resource.data.adminKey == "MARIAM27";
    }

    match /meta/tournament {
      allow read: if true;
      allow create, update: if isAdminWrite();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isAdminWrite();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if isAdminWrite();
      allow update: if isAdminWrite()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['celebratingPhoto'])
          && resource.data.celebratingPhoto == ''
          && request.resource.data.celebratingPhoto is string
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sadPhoto'])
          && resource.data.sadPhoto == ''
          && request.resource.data.sadPhoto is string
        );
    }
  }
}
